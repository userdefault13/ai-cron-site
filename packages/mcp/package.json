		"model-context-protocol",
		"x402",
		"cron",
		"scheduler",
		"ai-agents",
		"base",
		"usdc",
		"webhook",
		"coinbase"
	],
	"license": "MIT",
	"author": "userdefault13",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/userdefault13/ai-cron-site.git"
	},
	"homepage": "https://web-seven-ecru-65.vercel.app",
	"bugs": {
		"url": "https://github.com/userdefault13/ai-cron-site/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc && node -e \"const fs=require('fs');fs.chmodSync('dist/index.js',0o755)\"",
